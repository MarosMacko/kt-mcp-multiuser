# Nastavenia kt-mcp. Skopíruj na .env (Docker) alebo /etc/kt-mcp/kt-mcp.env (systemd)
# a vyplň. Hodnoty s medzerami alebo špeciálnymi znakmi daj do úvodzoviek.
# Podrobnosti: docs/SELF-HOSTING.md

# ── Povinné ───────────────────────────────────────────────────────────────

# Docker (docker-compose.yml): len doména, bez https://. PUBLIC_URL sa z nej poskladá sám
# a Caddy pre ňu automaticky vybaví HTTPS certifikát.
KT_DOMAIN=kt.example.com

# Bez Dockeru: verejná HTTPS adresa servera, presne tak, ako ju vidia klienti
# (schéma + doména, bez cesty a lomky na konci). Je to OAuth issuer, takže po jej
# zmene sa všetci musia pripojiť nanovo.
PUBLIC_URL=https://kt.example.com

# 32 náhodných bajtov v base64:   openssl rand -base64 32
# Spolu s tokenom každého používateľa šifruje jeho uložené prihlásenie. Drž ho v tajnosti
# a zálohuj. Keď ho zmeníš alebo stratíš, všetci sa musia prihlásiť znova (nič iné sa nestratí).
CREDENTIALS_KEY=

# ── Odporúčané (zobrazí sa na stránke /privacy) ───────────────────────────

# Kto server prevádzkuje a ako ťa zastihnúť (e-mail alebo URL). Ak server púšťaš
# aj iným ľuďom, kontakt by tam mal byť.
OPERATOR_NAME=
OPERATOR_CONTACT=

# ── Voliteľné ─────────────────────────────────────────────────────────────

# Obmedzí server na zoznam e-mailov (jeden na riadok, # komentáre). Zmeny v súbore
# platia hneď, bez reštartu; vyškrtnutý používateľ stratí prístup pri ďalšej požiadavke.
# Prázdne = server môže používať ktokoľvek s účtom na kaloricketabulky.sk alebo .cz.
ALLOWED_USERS_FILE=

# Povoliť lokálnych MCP klientov (Claude Code, VS Code, MCP Inspector...), ktorí
# dostávajú výsledok prihlásenia na localhost. Claude a ChatGPT (web, desktop, mobil) fungujú vždy.
ALLOW_LOCAL_CLIENTS=true

# Ďalšie presné OAuth redirect URI, ktoré môže klient zaregistrovať (oddelené medzerou),
# napr. pre klienta, ktorý používa vlastnú schému. Pridávaj len adresy, ktorým veríš.
EXTRA_REDIRECT_URIS=

# Koľko neúspešných prihlásení do Kalorických tabuliek za hodinu (spolu za všetkých) server
# znesie, kým prihlasovanie na chvíľu pozastaví. Chráni web aj tvoju IP pred zablokovaním.
MAX_FAILED_LOGINS_PER_HOUR=60

# Zverejniť počet pripojených účtov na /badge/users.json (pre shields.io odznak, napr. v README).
# Len číslo, nikdy kto. Vypnuté = adresa vráti 404.
PUBLIC_USER_COUNT=false

# Počet reverzných proxy pred aplikáciou, ktorým sa verí hlavička X-Forwarded-For.
# 1 = jedna proxy (Caddy/nginx), ktorá hlavičku PREPISUJE skutočnou IP klienta.
TRUST_PROXY_HOPS=1

# Kde aplikácia počúva a kam ukladá stav. Docker ich nastavuje sám.
HOST=127.0.0.1
PORT=8092
STATE_DIR=./data
