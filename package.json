{
  "name": "kt-mcp-multiuser",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "MCP server for the Kalorické tabuľky food diary (kaloricketabulky.sk / .cz): multi-user, sign in with your own account, for Claude, ChatGPT and local MCP clients",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarosMacko/kt-mcp-multiuser.git"
  },
  "bugs": "https://github.com/MarosMacko/kt-mcp-multiuser/issues",
  "homepage": "https://github.com/MarosMacko/kt-mcp-multiuser#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/build-info.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "e2e": "npm run build && node scripts/e2e-auth.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
