#!/usr/bin/env bash
# Optional hardening (see Caddyfile.snippet next to this file): refreshes the ChatGPT connector egress
# IP ranges allowed to reach kt-mcp (next to Anthropic's fixed range, which lives in the Caddyfile)
# from OpenAI's published list, into a Caddy matcher line imported by the kt-mcp site block. Reloads
# Caddy only when the ranges changed. On any error (download, parse, sanity check, caddy validate)
# the previous file stays in place.
# Install as /usr/local/sbin/kt-openai-ips-update; run by kt-openai-ips.timer.
set -euo pipefail

URL=https://openai.com/chatgpt-connectors.json
OUT=/etc/caddy/generated/openai-connector-ips.caddy
CADDYFILE=/etc/caddy/Caddyfile

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

curl -fsS --max-time 30 --retry 2 -A "kt-mcp-ip-updater" "$URL" -o "$work/list.json"

python3 -I - "$work/list.json" "$work/new.caddy" "$URL" <<'PY'
import ipaddress, json, sys

src, dst, url = sys.argv[1:4]
data = json.load(open(src))
nets = set()
for entry in data["prefixes"]:
    for key in ("ipv4Prefix", "ipv6Prefix"):
        if key in entry:
            net = ipaddress.ip_network(entry[key], strict=False)
            # Anything this broad is not a connector egress range; refuse rather than open up.
            if net.prefixlen < (8 if net.version == 4 else 32):
                sys.exit(f"refusing suspiciously broad prefix {net}")
            nets.add(net)
if len(nets) < 20:
    sys.exit(f"only {len(nets)} prefixes in {url}, refusing")
ordered = sorted(nets, key=lambda n: (n.version, n))
with open(dst, "w") as f:
    f.write(f"# Generated by kt-openai-ips-update from {url} - do not edit (creationTime {data.get('creationTime')}).\n")
    f.write("# Used inside the @not_ai_client matcher of the kt-mcp site in /etc/caddy/Caddyfile.\n")
    f.write("not remote_ip " + " ".join(map(str, ordered)) + "\n")
print(f"{len(ordered)} prefixes, creationTime {data.get('creationTime')}")
PY

# Only the matcher line matters; the header changes with every publication.
if [[ -f "$OUT" ]] && diff -q <(grep -v '^#' "$OUT") <(grep -v '^#' "$work/new.caddy") >/dev/null; then
  echo "unchanged"
  exit 0
fi

install -d -m 0755 "$(dirname "$OUT")"
[[ -f "$OUT" ]] && cp -p "$OUT" "$work/old.caddy"
install -m 0644 "$work/new.caddy" "$OUT"
if ! runuser -u caddy -- caddy validate --adapter caddyfile --config "$CADDYFILE" >"$work/validate.log" 2>&1; then
  cat "$work/validate.log" >&2
  if [[ -f "$work/old.caddy" ]]; then install -m 0644 "$work/old.caddy" "$OUT"; fi
  echo "caddy validate failed, kept the previous list" >&2
  exit 1
fi
systemctl reload caddy
echo "updated and reloaded caddy"
