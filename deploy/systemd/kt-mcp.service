# kt-mcp as a systemd service behind a reverse proxy on the same machine.
# Install: see docs/SELF-HOSTING.md ("Variant B"). Settings live in /etc/kt-mcp/kt-mcp.env.
[Unit]
Description=kt-mcp - Kalorické tabuľky MCP server
After=network-online.target
Wants=network-online.target

[Service]
User=kt-mcp
Group=kt-mcp
EnvironmentFile=/etc/kt-mcp/kt-mcp.env
Environment=NODE_ENV=production
Environment=STATE_DIR=/var/lib/kt-mcp
ExecStart=/usr/bin/node /opt/kt-mcp/dist/index.js
Restart=on-failure
RestartSec=3
StateDirectory=kt-mcp
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# No MemoryDenyWriteExecute: V8's JIT needs writable+executable pages.
SystemCallArchitectures=native
MemoryMax=512M

[Install]
WantedBy=multi-user.target
